<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>GerTwinsApp — Фитнес Дневник</title>
    <!-- React & Babel для запуска прямо в браузере -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Tailwind CSS для стилей -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { background-color: #121212; color: #e0e0e0; font-family: system-ui, -apple-system, sans-serif; }
        .bg-graphite-dark { background-color: #18181b; }
        .bg-graphite-card { background-color: #212126; }
        .bg-graphite-input { background-color: #2a2a30; }
        .text-orange-accent { color: #f97316; }
        .bg-orange-accent { background-color: #f97316; }
        .border-orange-accent { border-color: #f97316; }
        /* Скрытие скроллбара */
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: #18181b; }
        ::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 2px; }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        // Встроенная иконка-логотип GerTwinsApp
        const AppLogo = ({ className = "w-10 h-10" }) => (
            <div className={`relative flex items-center justify-center bg-graphite-input rounded-xl border border-orange-accent/40 overflow-hidden shadow-lg shadow-orange-500/10 ${className}`}>
                <svg viewBox="0 0 512 512" className="w-4/5 h-4/5 drop-shadow-md" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M432 150C390 90 310 60 220 70C110 82 30 170 30 280C30 390 120 470 230 460C320 450 395 390 435 320" stroke="#f97316" strokeWidth="65" strokeLinecap="round"/>
                    <path d="M380 180L420 140M340 220L400 160" stroke="#f97316" strokeWidth="25" strokeLinecap="round"/>
                    <circle cx="210" cy="270" r="100" fill="#f97316" fillOpacity="0.2"/>
                    <!-- Мускулистая рука с гантелью -->
                    <path d="M190 400C150 400 120 370 120 330C120 300 140 280 170 270C200 260 230 280 250 250C270 220 250 190 280 170C300 155 330 170 350 200L380 230C395 245 395 270 380 285L350 315C335 330 310 330 295 315L270 290C265 310 250 340 220 370C205 385 195 400 190 400Z" fill="#f97316"/>
                    <rect x="220" y="160" width="40" height="120" rx="8" transform="rotate(45 220 160)" fill="#333" stroke="#f97316" strokeWidth="8"/>
                    <rect x="180" y="130" width="25" height="150" rx="6" transform="rotate(45 180 130)" fill="#555"/>
                    <rect x="300" y="240" width="25" height="150" rx="6" transform="rotate(45 300 240)" fill="#555"/>
                </svg>
            </div>
        );

        function App() {
            const [activeTab, setActiveTab] = useState('workouts');
            const [timerSeconds, setTimerSeconds] = useState(0);
            const [isTimerActive, setIsTimerActive] = useState(false);

            // Данные в localStorage
            const [workouts, setWorkouts] = useState(() => JSON.parse(localStorage.getItem('gt_workouts')) || []);
            const [foodLogs, setFoodLogs] = useState(() => JSON.parse(localStorage.getItem('gt_food')) || {
                breakfast: [], lunch: [], dinner: [], snacks: []
            });
            const [bodyStats, setBodyStats] = useState(() => JSON.parse(localStorage.getItem('gt_body')) || []);
            const [waterDrank, setWaterDrank] = useState(() => Number(localStorage.getItem('gt_water')) || 0);
            const waterGoal = 2500;

            useEffect(() => {
                localStorage.setItem('gt_workouts', JSON.stringify(workouts));
            }, [workouts]);

            useEffect(() => {
                localStorage.setItem('gt_food', JSON.stringify(foodLogs));
            }, [foodLogs]);

            useEffect(() => {
                localStorage.setItem('gt_body', JSON.stringify(bodyStats));
            }, [bodyStats]);

            useEffect(() => {
                localStorage.setItem('gt_water', waterDrank);
            }, [waterDrank]);

            // Таймер отдыха
            useEffect(() => {
                let interval = null;
                if (isTimerActive && timerSeconds > 0) {
                    interval = setInterval(() => setTimerSeconds(s => s - 1), 1000);
                } else if (timerSeconds === 0) {
                    setIsTimerActive(false);
                }
                return () => clearInterval(interval);
            }, [isTimerActive, timerSeconds]);

            const startTimer = (sec) => {
                setTimerSeconds(sec);
                setIsTimerActive(true);
            };

            return (
                <div className="flex flex-col min-h-screen max-w-md mx-auto bg-graphite-dark text-gray-100 pb-20 shadow-2xl border-x border-gray-800">
                    {/* Шапкка */}
                    <header className="flex items-center justify-between p-4 bg-graphite-card border-b border-gray-800 sticky top-0 z-50">
                        <div className="flex items-center space-x-3">
                            <AppLogo className="w-10 h-10" />
                            <div>
                                <h1 className="font-bold text-lg tracking-wide text-white">GerTwins<span className="text-orange-accent">App</span></h1>
                                <p className="text-xs text-gray-400">Твой личный фитнес-штаб</p>
                            </div>
                        </div>
                        {isTimerActive && (
                            <div className="flex items-center bg-orange-accent/20 border border-orange-accent px-3 py-1 rounded-full animate-pulse">
                                <span className="text-orange-accent font-mono font-bold text-sm">⏱ {Math.floor(timerSeconds / 60)}:{String(timerSeconds % 60).padStart(2, '0')}</span>
                            </div>
                        )}
                    </header>

                    {/* Основной контент */}
                    <main className="flex-1 p-4 overflow-y-auto">
                        {activeTab === 'workouts' && <WorkoutsTab workouts={workouts} setWorkouts={setWorkouts} startTimer={startTimer} />}
                        {activeTab === 'nutrition' && <NutritionTab foodLogs={foodLogs} setFoodLogs={setFoodLogs} waterDrank={waterDrank} setWaterDrank={setWaterDrank} waterGoal={waterGoal} />}
                        {activeTab === 'body' && <BodyTab bodyStats={bodyStats} setBodyStats={setBodyStats} />}
                        {activeTab === 'stats' && <StatsTab workouts={workouts} bodyStats={bodyStats} />}
                    </main>

                    {/* Нижняя навигация */}
                    <nav className="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-graphite-card border-t border-gray-800 flex justify-around p-3 z-50">
                        <NavButton active={activeTab === 'workouts'} onClick={() => setActiveTab('workouts')} icon="🏋️‍♂️" label="Тренировки" />
                        <NavButton active={activeTab === 'nutrition'} onClick={() => setActiveTab('nutrition')} icon="🥗" label="Питание" />
                        <NavButton active={activeTab === 'body'} onClick={() => setActiveTab('body')} icon="📏" label="Замеры" />
                        <NavButton active={activeTab === 'stats'} onClick={() => setActiveTab('stats')} icon="📈" label="Прогресс" />
                    </nav>
                </div>
            );
        }

        function NavButton({ active, onClick, icon, label }) {
            return (
                <button onClick={onClick} className={`flex flex-col items-center transition ${active ? 'text-orange-accent scale-105' : 'text-gray-400 hover:text-gray-200'}`}>
                    <span className="text-xl">{icon}</span>
                    <span className="text-[10px] mt-1 font-medium">{label}</span>
                </button>
            );
        }

        // 1. Вкладка Тренировки
        function WorkoutsTab({ workouts, setWorkouts, startTimer }) {
            const [workoutName, setWorkoutName] = useState('');
            const [exercises, setExercises] = useState([]);
            const [exName, setExName] = useState('');
            const [weight, setWeight] = useState('');
            const [reps, setReps] = useState('');

            const addExercise = () => {
                if (!exName) return;
                setExercises([...exercises, { id: Date.now(), name: exName, weight: weight || 0, reps: reps || 0 }]);
                setExName(''); setWeight(''); setReps('');
            };

            const saveWorkout = () => {
                if (!workoutName || exercises.length === 0) return;
                setWorkouts([{ id: Date.now(), date: new Date().toLocaleDateString(), name: workoutName, exercises }, ...workouts]);
                setWorkoutName(''); setExercises([]);
            };

            return (
                <div className="space-y-6">
                    <div className="bg-graphite-card p-4 rounded-2xl border border-gray-800 shadow-lg">
                        <h2 className="text-lg font-bold text-orange-accent mb-3">Новая тренировка</h2>
                        <input type="text" placeholder="Название (например, День груди)" value={workoutName} onChange={e => setWorkoutName(e.target.value)} className="w-full bg-graphite-input p-3 rounded-xl border border-gray-700 text-white mb-3 focus:outline-none focus:border-orange-accent" />
                        
                        <div className="space-y-2 mb-3">
                            <input type="text" placeholder="Упражнение (Жим лежа)" value={exName} onChange={e => setExName(e.target.value)} className="w-full bg-graphite-input p-2.5 rounded-xl border border-gray-700 text-white text-sm" />
                            <div className="grid grid-cols-2 gap-2">
                                <input type="number" placeholder="Вес (кг)" value={weight} onChange={e => setWeight(e.target.value)} className="bg-graphite-input p-2.5 rounded-xl border border-gray-700 text-white text-sm" />
                                <input type="number" placeholder="Повторения" value={reps} onChange={e => setReps(e.target.value)} className="bg-graphite-input p-2.5 rounded-xl border border-gray-700 text-white text-sm" />
                            </div>
                            <button onClick={addExercise} className="w-full bg-gray-800 hover:bg-gray-700 text-orange-accent border border-orange-accent/40 font-semibold py-2 rounded-xl text-sm transition">+ Добавить упражнение</button>
                        </div>

                        {exercises.length > 0 && (
                            <div className="space-y-2 mb-4">
                                {exercises.map(ex => (
                                    <div key={ex.id} className="flex justify-between items-center bg-graphite-input p-2.5 rounded-xl text-sm">
                                        <span>{ex.name}</span>
                                        <span className="text-orange-accent font-semibold">{ex.weight} кг × {ex.reps} пов.</span>
                                    </div>
                                ))}
                            </div>
                        )}

                        <button onClick={saveWorkout} className="w-full bg-orange-accent hover:bg-orange-600 text-white font-bold py-3 rounded-xl shadow-lg shadow-orange-500/20 transition">Сохранить тренировку</button>
                    </div>

                    <div className="flex justify-around bg-graphite-card p-3 rounded-xl border border-gray-800">
                        <button onClick={() => startTimer(60)} className="bg-graphite-input px-3 py-1.5 rounded-lg text-xs font-bold text-orange-accent border border-orange-accent/30">⏱ Отдых 1 мин</button>
                        <button onClick={() => startTimer(90)} className="bg-graphite-input px-3 py-1.5 rounded-lg text-xs font-bold text-orange-accent border border-orange-accent/30">⏱ Отдых 1.5 мин</button>
                        <button onClick={() => startTimer(120)} className="bg-graphite-input px-3 py-1.5 rounded-lg text-xs font-bold text-orange-accent border border-orange-accent/30">⏱ Отдых 2 мин</button>
                    </div>

                    <div className="space-y-3">
                        <h3 className="font-bold text-gray-300">История тренировок</h3>
                        {workouts.length === 0 ? <p className="text-gray-500 text-sm">Нет сохраненных тренировок</p> : workouts.map(w => (
                            <div key={w.id} className="bg-graphite-card p-4 rounded-xl border border-gray-800">
                                <div className="flex justify-between items-center mb-2">
                                    <h4 className="font-bold text-white">{w.name}</h4>
                                    <span className="text-xs text-gray-400">{w.date}</span>
                                </div>
                                <div className="space-y-1">
                                    {w.exercises.map((ex, idx) => (
                                        <div key={idx} className="text-xs text-gray-400 flex justify-between">
                                            <span>{ex.name}</span>
                                            <span className="text-orange-accent font-medium">{ex.weight} кг / {ex.reps} пов.</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            );
        }

        // 2. Вкладка Питание и Вода
        function NutritionTab({ foodLogs, setFoodLogs, waterDrank, setWaterDrank, waterGoal }) {
            const [mealType, setMealType] = useState('breakfast');
            const [foodName, setFoodName] = useState('');
            const [calories, setCalories] = useState('');

            const addFood = () => {
                if (!foodName || !calories) return;
                setFoodLogs({ ...foodLogs, [mealType]: [...foodLogs[mealType], { id: Date.now(), name: foodName, calories: Number(calories) }] });
                setFoodName(''); setCalories('');
            };

            const totalCalories = Object.values(foodLogs).flat().reduce((acc, item) => acc + item.calories, 0);

            return (
                <div className="space-y-6">
                    <div className="bg-graphite-card p-4 rounded-2xl border border-gray-800">
                        <div className="flex justify-between items-center mb-4">
                            <h2 className="text-lg font-bold text-orange-accent">Дневной рацион</h2>
                            <span className="bg-orange-accent/20 text-orange-accent px-3 py-1 rounded-full text-sm font-bold">{totalCalories} ккал</span>
                        </div>

                        <div className="space-y-3 mb-4">
                            <select value={mealType} onChange={e => setMealType(e.target.value)} className="w-full bg-graphite-input p-3 rounded-xl border border-gray-700 text-white text-sm">
                                <option value="breakfast">Завтрак</option>
                                <option value="lunch">Обед</option>
                                <option value="dinner">Ужин</option>
                                <option value="snacks">Перекусы</option>
                            </select>
                            <input type="text" placeholder="Продукт или блюдо" value={foodName} onChange={e => setFoodName(e.target.value)} className="w-full bg-graphite-input p-3 rounded-xl border border-gray-700 text-white text-sm" />
                            <input type="number" placeholder="Калории (ккал)" value={calories} onChange={e => setCalories(e.target.value)} className="w-full bg-graphite-input p-3 rounded-xl border border-gray-700 text-white text-sm" />
                            <button onClick={addFood} className="w-full bg-orange-accent hover:bg-orange-600 text-white font-bold py-2.5 rounded-xl text-sm transition">Добавить прием пищи</button>
                        </div>
                    </div>

                    {/* Трекер воды */}
                    <div className="bg-graphite-card p-4 rounded-2xl border border-gray-800">
                        <div className="flex justify-between items-center mb-2">
                            <h3 className="font-bold text-sm text-gray-200">💧 Баланс воды</h3>
                            <span className="text-xs text-orange-accent font-bold">{waterDrank} / {waterGoal} мл</span>
                        </div>
                        <div className="w-full bg-gray-800 h-3 rounded-full overflow-hidden mb-3">
                            <div className="bg-orange-accent h-full transition-all" style={{ width: `${Math.min(100, (waterDrank / waterGoal) * 100)}%` }}></div>
                        </div>
                        <div className="grid grid-cols-3 gap-2">
                            <button onClick={() => setWaterDrank(w => w + 250)} className="bg-graphite-input py-2 rounded-xl text-xs font-semibold text-orange-accent border border-orange-accent/30">+250 мл</button>
                            <button onClick={() => setWaterDrank(w => w + 500)} className="bg-graphite-input py-2 rounded-xl text-xs font-semibold text-orange-accent border border-orange-accent/30">+500 мл</button>
                            <button onClick={() => setWaterDrank(0)} className="bg-gray-800 py-2 rounded-xl text-xs text-gray-400">Сброс</button>
                        </div>
                    </div>
                </div>
            );
        }

        // 3. Вкладка Вес и Замеры
        function BodyTab({ bodyStats, setBodyStats }) {
            const [weight, setWeight] = useState('');
            const [chest, setChest] = useState('');
            const [waist, setWaist] = useState('');
            const [hips, setHips] = useState('');

            const addStats = () => {
                if (!weight) return;
                setBodyStats([{ id: Date.now(), date: new Date().toLocaleDateString(), weight, chest, waist, hips }, ...bodyStats]);
                setWeight(''); setChest(''); setWaist(''); setHips('');
            };

            return (
                <div className="space-y-6">
                    <div className="bg-graphite-card p-4 rounded-2xl border border-gray-800">
                        <h2 className="text-lg font-bold text-orange-accent mb-3">Замеры тела</h2>
                        <div className="space-y-3 mb-4">
                            <input type="number" placeholder="Вес тела (кг)" value={weight} onChange={e => setWeight(e.target.value)} className="w-full bg-graphite-input p-3 rounded-xl border border-gray-700 text-white text-sm" />
                            <div className="grid grid-cols-3 gap-2">
                                <input type="number" placeholder="Грудь (см)" value={chest} onChange={e => setChest(e.target.value)} className="bg-graphite-input p-2.5 rounded-xl border border-gray-700 text-white text-xs" />
                                <input type="number" placeholder="Талия (см)" value={waist} onChange={e => setWaist(e.target.value)} className="bg-graphite-input p-2.5 rounded-xl border border-gray-700 text-white text-xs" />
                                <input type="number" placeholder="Бедра (см)" value={hips} onChange={e => setHips(e.target.value)} className="bg-graphite-input p-2.5 rounded-xl border border-gray-700 text-white text-xs" />
                            </div>
                            <button onClick={addStats} className="w-full bg-orange-accent hover:bg-orange-600 text-white font-bold py-2.5 rounded-xl text-sm transition">Сохранить замеры</button>
                        </div>
                    </div>

                    <div className="space-y-3">
                        <h3 className="font-bold text-gray-300">История изменений</h3>
                        {bodyStats.length === 0 ? <p className="text-gray-500 text-sm">Замеров пока нет</p> : bodyStats.map(s => (
                            <div key={s.id} className="bg-graphite-card p-4 rounded-xl border border-gray-800 flex justify-between items-center">
                                <span className="text-xs text-gray-400">{s.date}</span>
                                <span className="font-bold text-white text-base">{s.weight} кг</span>
                                <span className="text-xs text-orange-accent">Гр: {s.chest || '-'} | Тал: {s.waist || '-'}</span>
                            </div>
                        ))}
                    </div>
                </div>
            );
        }

        // 4. Вкладка Прогресс
        function StatsTab({ workouts, bodyStats }) {
            return (
                <div className="space-y-6">
                    <div className="bg-graphite-card p-5 rounded-2xl border border-gray-800 text-center">
                        <h2 className="text-lg font-bold text-orange-accent mb-2">Статистика и Аналитика</h2>
                        <p className="text-xs text-gray-400 mb-4">Твои успехи за всё время тренировок</p>
                        <div className="grid grid-cols-2 gap-3">
                            <div className="bg-graphite-input p-4 rounded-xl border border-gray-800">
                                <span className="text-2xl font-bold text-white">{workouts.length}</span>
                                <p className="text-xs text-gray-400 mt-1">Тренировок проведено</p>
                            </div>
                            <div className="bg-graphite-input p-4 rounded-xl border border-gray-800">
                                <span className="text-2xl font-bold text-orange-accent">{bodyStats[0]?.weight || '—'} кг</span>
                                <p className="text-xs text-gray-400 mt-1">Текущий вес</p>
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        ReactDOM.render(<App />, document.getElementById('root'));
    </script>
</body>
</html>
